# ─────────────────────────────────────────────────────────────
# STAYR — environment configuration
# Copy to .env.local and fill in. Nothing here is required to run
# locally: unconfigured integrations fall back to labelled dev modes.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser — never
# put secrets in them.
# ─────────────────────────────────────────────────────────────

# Canonical site URL (used for metadata, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Admin backoffice (/admin) ────────────────────────────────
# Password for the admin (min. 8 characters). Without it the admin is
# switched off. Use a long random value in production.
ADMIN_PASSWORD=
# Secret used to sign the admin session cookie (any long random string).
ADMIN_SESSION_SECRET=

# ── Database (server only) ───────────────────────────────────
# Leads, CRM, bookings, analytics and admin settings live here.
# Empty = a local SQLite file at .data/stayr.db (development, or one
# server with a persistent disk). On serverless hosts (e.g. Vercel) use
# a hosted libSQL / Turso database: libsql://your-db.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# ── Lead webhook (server only, optional) ─────────────────────
# Leads are always stored in the built-in CRM. If this is set, a JSON
# copy of every lead, application and booking is also POSTed here
# (Make, Zapier, n8n, or another CRM).
LEAD_WEBHOOK_URL=
# Optional shared secret, sent as the "x-stayr-signature" header.
LEAD_WEBHOOK_SECRET=

# ── Case study video ─────────────────────────────────────────
# Direct MP4/WebM URL (or a file in /public, e.g. /media/case-study.mp4)
NEXT_PUBLIC_VSL_VIDEO_URL=
# WebVTT captions file (e.g. /media/case-study.en.vtt)
NEXT_PUBLIC_VSL_CAPTIONS_URL=

# ── Scheduling ───────────────────────────────────────────────
# The built-in scheduler is managed in the admin (Agenda). Set this only
# to use an external tool instead: Calendly links are embedded inline
# and confirmation events are tracked; other providers open in a new tab.
NEXT_PUBLIC_BOOKING_URL=

# ── Analytics (all optional, all consent-gated) ──────────────
# Prefer the admin (Tracking): Meta Pixel + Conversions API, Google and
# TikTok Pixel + Events API are configured there and stored in the
# database. The variables below are only build-time defaults.
# If GTM is set it becomes the single tag manager: events are only
# pushed to the dataLayer and GA4 / Meta / Google Ads should be
# configured inside GTM. The direct IDs below are then ignored to
# avoid duplicate fires.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Google Ads conversion labels (the part after the slash in send_to)
NEXT_PUBLIC_GOOGLE_ADS_LABEL_OPTIN=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_APPLICATION=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_CALL=

# ── Company details shown in the footer / legal pages ────────
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LINKEDIN_URL=
